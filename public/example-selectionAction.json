{
	"version": "1.0",
	"settings": {
		"disableFallbackUi": true
	},
	"sessions": [
		{
			"id": "default",
			"slug": "selectioninput-basic-alwaysactive-11-2"
		}
	],
	"appBuilderOverride": {
		"version": "1.0",
		"containers": [
			{
				"name": "right",
				"widgets": [
					{
						"type": "text",
						"props": {
							"markdown": "### Selection action\nUse the bottom toolbar. The selection allows two of the three boxes."
						}
					},
					{
						"type": "controls",
						"props": {
							"controls": [
								{
									"type": "parameter",
									"props": {
										"name": "SelectBox",
										"sessionId": "default_appbuilder"
									}
								}
							]
						}
					}
				]
			},
			{
				"name": "toolbar",
				"props": {
					"id": "selection-action-toolbar",
					"side": "bottom",
					"align": "center"
				},
				"groups": [
					[
						{
							"type": "action",
							"props": {
								"label": "Select box 1",
								"icon": "tabler:hand-finger",
								"tooltip": "Select box_1",
								"definition": {
									"type": "selection",
									"props": {
										"select": ["Boxes.box_1"]
									}
								}
							}
						},
						{
							"type": "action",
							"props": {
								"label": "Select all",
								"icon": "tabler:select-all",
								"tooltip": "Select all boxes (the first two fit)",
								"definition": {
									"type": "selection",
									"props": {
										"select": ["Boxes.*"]
									}
								}
							}
						},
						{
							"type": "action",
							"props": {
								"label": "Only box 3",
								"icon": "tabler:target",
								"tooltip": "Deselect all boxes, select box_3",
								"definition": {
									"type": "selection",
									"props": {
										"select": ["Boxes.box_3"],
										"deselect": ["Boxes.*"]
									}
								}
							}
						},
						{
							"type": "action",
							"props": {
								"label": "Deselect all",
								"icon": "tabler:circle-off",
								"tooltip": "Deselect all boxes",
								"definition": {
									"type": "selection",
									"props": {
										"deselect": ["Boxes.*"],
										"parameter": {
											"name": "SelectBox",
											"sessionId": "default_appbuilder"
										}
									}
								}
							}
						}
					]
				]
			}
		],
		"parameters": [
			{
				"defval": "{\"names\":[]}",
				"hidden": false,
				"id": "SelectBox",
				"interactionType": "selection",
				"name": "SelectBox",
				"settings": {
					"props": {
						"activeMode": "alwaysActive",
						"hover": true,
						"maximumSelection": 2,
						"minimumSelection": 0,
						"nameFilter": ["Boxes.*"]
					},
					"type": "selection"
				},
				"type": "Interaction",
				"value": "{\"names\":[]}"
			}
		]
	}
}
