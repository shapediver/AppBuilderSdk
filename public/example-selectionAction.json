{
	"version": "1.0",
	"settings": {
		"disableFallbackUi": true
	},
	"sessions": [
		{
			"id": "default",
			"slug": "selectioninput-basic-alwaysactive-11-2"
		}
	],
	"appBuilderOverride": {
		"version": "1.0",
		"actionSlots": {
			"selecton": {
				"eventProps": {
					"type": "selection",
					"props": {
						"nameFilter": ["Boxes.*"],
						"minimumSelection": 0,
						"maximumSelection": 2,
						"hover": true
					}
				},
				"action": {
					"type": "setContainerVisibility",
					"props": {
						"container": {
							"name": "anchor2d",
							"props": {
								"id": "root-selection"
							}
						},
						"mode": "toggle"
					}
				}
			},
			"selectoff": {
				"eventProps": {
					"type": "selection",
					"props": {
						"nameFilter": ["Boxes.*"],
						"minimumSelection": 0,
						"maximumSelection": 2,
						"hover": true
					}
				},
				"action": {
					"type": "setContainerVisibility",
					"props": {
						"container": {
							"name": "anchor2d",
							"props": {
								"id": "root-selection"
							}
						},
						"mode": "close"
					}
				}
			}
		},
		"containers": [
			{
				"name": "anchor2d",
				"props": {
					"id": "root-selection",
					"location": [24, 88],
					"justification": "TL",
					"exclusive": false,
					"defaultOpen": false,
					"useCloseButton": true,
					"width": 240
				},
				"widgets": [
					{
						"type": "text",
						"props": {
							"markdown": "### Root selection"
						}
					}
				]
			},
			{
				"name": "right",
				"widgets": [
					{
						"type": "text",
						"props": {
							"markdown": "### Selection action\nButtons without a parameter change the root selection (the panel toggles). Buttons that name SelectBox change that parameter. It allows two of the three boxes."
						}
					},
					{
						"type": "controls",
						"props": {
							"controls": [
								{
									"type": "parameter",
									"props": {
										"name": "SelectBox",
										"sessionId": "default_appbuilder"
									}
								}
							]
						}
					}
				]
			},
			{
				"name": "toolbar",
				"props": {
					"id": "selection-action-toolbar",
					"side": "bottom",
					"align": "center"
				},
				"groups": [
					[
						{
							"type": "action",
							"props": {
								"label": "Select box 1",
								"icon": "tabler:hand-finger",
								"tooltip": "Root selection: select box_1",
								"definition": {
									"type": "selection",
									"props": {
										"select": ["Boxes.box_1"]
									}
								}
							}
						},
						{
							"type": "action",
							"props": {
								"label": "Deselect scene",
								"icon": "tabler:circle-off",
								"tooltip": "Root selection: deselect the boxes",
								"definition": {
									"type": "selection",
									"props": {
										"deselect": ["Boxes.*"]
									}
								}
							}
						},
						{
							"type": "action",
							"props": {
								"label": "Select all",
								"icon": "tabler:select-all",
								"tooltip": "Parameter: select all boxes (the first two fit)",
								"definition": {
									"type": "selection",
									"props": {
										"select": ["Boxes.*"],
										"parameter": {
											"name": "SelectBox",
											"sessionId": "default_appbuilder"
										}
									}
								}
							}
						},
						{
							"type": "action",
							"props": {
								"label": "Only box 3",
								"icon": "tabler:target",
								"tooltip": "Parameter: deselect all boxes, select box_3",
								"definition": {
									"type": "selection",
									"props": {
										"select": ["Boxes.box_3"],
										"deselect": ["Boxes.*"],
										"parameter": {
											"name": "SelectBox",
											"sessionId": "default_appbuilder"
										}
									}
								}
							}
						},
						{
							"type": "action",
							"props": {
								"label": "Deselect parameter",
								"icon": "tabler:square-off",
								"tooltip": "Parameter: deselect all boxes",
								"definition": {
									"type": "selection",
									"props": {
										"deselect": ["Boxes.*"],
										"parameter": {
											"name": "SelectBox",
											"sessionId": "default_appbuilder"
										}
									}
								}
							}
						}
					]
				]
			}
		],
		"parameters": [
			{
				"defval": "{\"names\":[]}",
				"hidden": false,
				"id": "SelectBox",
				"interactionType": "selection",
				"name": "SelectBox",
				"settings": {
					"props": {
						"activeMode": "alwaysActive",
						"hover": true,
						"maximumSelection": 2,
						"minimumSelection": 0,
						"nameFilter": ["Boxes.*"]
					},
					"type": "selection"
				},
				"type": "Interaction"
			}
		]
	}
}
