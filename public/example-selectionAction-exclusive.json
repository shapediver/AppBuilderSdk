		"containers": [
			{
				"name": "right",
				"widgets": [
					{
						"type": "text",
						"props": {
							"markdown": "### Selection action on exclusive rectangle transforms\nEach box has its own exclusive rectangle transform with a minimum selection of 1. Selecting a box deselects the other one. A click on the selected box does not deselect it. The deselect action does. Confirm and Cancel appear after a handle moves."
						}
					},
					{
						"type": "controls",
						"props": {
							"controls": [
								{
									"type": "parameter",
									"props": {
										"name": "RectOriginal",
										"sessionId": "default_appbuilder"
									}
								},
								{
									"type": "parameter",
									"props": {
										"name": "RectTranslated",
										"sessionId": "default_appbuilder"
									}
								}
							]
						}
					}
				]
			},
			{
				"name": "toolbar",
				"props": {
					"id": "selection-action-exclusive-toolbar",
					"side": "top",
					"align": "center"
				},
				"groups": [
					[
						{
							"type": "action",
							"props": {
								"label": "Select original",
								"icon": "tabler:hand-finger",
								"tooltip": "RectOriginal: select box_original",
								"definition": {
									"type": "selection",
									"props": {
										"select": ["Boxes.box_original"],
										"parameter": {
