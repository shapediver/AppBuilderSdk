								"definition": {
									"type": "selection",
									"props": {
										"deselect": ["Boxes.*"],
										"parameter": {
											"name": "RectOriginal",
											"sessionId": "default_appbuilder"
										}
									}
								}
							}
						},
						{
							"type": "action",
							"props": {
								"label": "Select translated",
								"icon": "tabler:target",
								"tooltip": "RectTranslated: select box_translated",
