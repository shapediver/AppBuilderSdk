{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"noEmit": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "./.tsbuild/jest",
		"rootDir": ".",
		"module": "commonjs",
		"moduleResolution": "bundler",
		"paths": {
			"@AppBuilderShared/*": ["./src/shared/*"],
			"@AppBuilderLib/*": ["./src/shared/*"],
			"~/*": ["./src/*"],
			"@modelstorage": ["./modelstorage.ts"]
		},
		"types": [
			"node",
			"@testing-library/jest-dom",
			"vite/client",
			"vite-plugin-svgr/client"
		]
	},
	"include": [
		"src/**/*.test.ts",
		"src/**/*.test.tsx",
		"src/**/*.spec.ts",
		"src/**/*.spec.tsx"
	],
	"exclude": []
}
