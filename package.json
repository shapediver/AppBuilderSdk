{
	"name": "shapediver-app-builder",
	"version": "1.12.1",
	"private": true,
	"type": "module",
	"homepage": "./",
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@iconify/react": "6.0.3",
		"@mantine/carousel": "9.7.4",
		"@mantine/charts": "9.7.4",
		"@mantine/core": "9.7.4",
		"@mantine/form": "9.7.4",
		"@mantine/hooks": "9.7.4",
		"@mantine/notifications": "9.7.4",
		"@plausible-analytics/tracker": "^0.4.6",
		"@sentry/react": "11.9.0",
		"@sentry/vite-plugin": "11.9.0",
		"@shapediver/sdk.geometry-api-sdk-v2": "4.4.0",
		"@shapediver/sdk.platform-api-sdk-v1": "3.0.3",
		"@shapediver/sdk.stargate-sdk-v1": "1.7.0",
		"@shapediver/viewer.features.attribute-visualization": "3.22.0-next.46",
		"@shapediver/viewer.features.drawing-tools": "3.22.0-next.46",
		"@shapediver/viewer.features.interaction": "3.22.0-next.46",
		"@shapediver/viewer.features.transformation-tools": "3.22.0-next.46",
		"@shapediver/viewer.session": "3.22.0-next.46",
		"@shapediver/viewer.shared.global-access-objects": "3.22.0-next.46",
		"@shapediver/viewer.shared.types": "3.22.0-next.46",
		"@shapediver/viewer.utils.mime-type": "1.1.0",
		"@shapediver/viewer.viewport": "3.22.0-next.46",
		"@tanstack/match-sorter-utils": "9.2.6",
		"@tanstack/react-table": "9.3.1",
		"@tanstack/react-virtual": "3.14.23",
		"gl-matrix": "3.4.4",
		"immer": "11.2.9",
		"langfuse": "3.39.2",
		"openai": "7.45.1",
		"post-robot": "8.0.32",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-infinite-scroll-hook": "6.0.1",
		"react-markdown": "10.1.0",
		"recharts": "3.10.1",
		"remark-directive": "4.0.0",
		"remark-gfm": "4.0.1",
		"unist-util-visit": "5.2.0",
		"zod": "4.6.7",
		"zustand": "5.0.16"
	},
	"scripts": {
		"start": "vite",
		"postinstall": "playwright install chromium",
		"build": "tsc && vite build",
		"optimize": "tsc && vite optimize --force",
		"preview": "vite preview",
		"eslint": "eslint --no-warn-ignored ./src ./*.ts ./tests ./typedoc",
		"eslint-fix": "eslint --fix --no-warn-ignored ./src ./*.ts ./tests ./typedoc",
		"prettier": "prettier --write ./src/ ./*.ts ./*.html ./tests ./typedoc",
		"test": "jest --config jest.config.mjs",
		"test-e2e": "playwright test",
		"test-e2e-quick": "playwright test --grep @quick",
		"test-e2e-deploy": "tsx ./scripts/deploy-e2e.ts",
		"test-e2e-ui": "playwright test --ui",
		"test-e2e-update-snapshots": "playwright test --update-snapshots",
		"pick-coords": "tsx ./scripts/pick-coords.ts",
		"docs": "node --max-old-space-size=4096 ./node_modules/typedoc/bin/typedoc",
		"eval:webmcp": "tsx src/shared/features/webmcp/evals/runWebmcpEvals.ts",
		"convert-slug-data": "tsx ./scripts/convertSlugData.ts",
		"build-appbuilder": "bash scripts/build-appbuilder.sh 0 v1/main",
		"build-appbuilder-platform": "bash scripts/build-appbuilder.sh 0 app/builder/v1/main",
		"publish-appbuilder": "bash scripts/build-appbuilder.sh 1 v1/main",
		"publish-appbuilder-platform": "bash scripts/build-appbuilder.sh 1 app/builder/v1/main",
		"publish": "bash scripts/build-appbuilder.sh 1",
		"generate:mantine-props-zod": "node scripts/generate-mantine-props-zod.mjs",
		"validate:settings": "node scripts/validate-settings-json.mjs"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "^1.64.1",
		"@sentry/cli": "3.8.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/jest": "30.0.0",
		"@types/node": "24.19.1",
		"@types/post-robot": "10.0.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/eslint-plugin": "8.72.1",
		"@typescript-eslint/parser": "8.72.1",
		"@vitejs/plugin-react": "6.1.2",
		"dotenv": "18.0.9",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.7",
		"eslint-plugin-react": "7.37.5",
		"globals": "^17.13.0",
		"jest": "30.5.2",
		"jest-environment-jsdom": "30.5.2",
		"prettier": "3.9.10",
		"prettier-plugin-organize-imports": "4.3.0",
		"ts-jest": "29.4.15",
		"ts-to-zod": "^5.1.0",
		"tsx": "4.23.15",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.14.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "8.3.5",
		"vite-bundle-analyzer": "1.3.9",
		"vite-plugin-svgr": "5.2.0",
		"web-vitals": "6.2.3"
	},
	"lint-staged": {
		"*.{js,json,yml,yaml,css,scss,ts,tsx,md}": [
			"prettier --write"
		]
	}
}