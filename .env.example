# Strict Zod validation when loading settings JSON (?settingsUrl=…).
# Requires restart of `pnpm start` after change.
VITE_VALIDATE_SETTINGS=true
# Chrome WebMCP Origin Trial token for *.shapediver.com (SS-9745).
# Get the token from 1Password. Leave empty to disable WebMCP tool registration.
VITE_WEBMCP_ORIGIN_TRIAL_TOKEN=
# WebMCP requires cross-origin isolation (COOP/COEP). Dev/preview: vite.config.ts
# server.headers and preview.headers. Production/static hosts must send the same
# headers (see public/_headers for Netlify and similar hosts).
