# Strict Zod validation when loading settings JSON (?settingsUrl=…).
# Requires restart of `pnpm start` after change.
VITE_VALIDATE_SETTINGS=true
# Local/preview: vite.config.ts sends Origin-Trial + COOP/COEP response headers.
# Production: CloudFront returns Origin-Trial, Cross-Origin-Opener-Policy, Cross-Origin-Embedder-Policy.
VITE_WEBMCP_ORIGIN_TRIAL_TOKEN=
