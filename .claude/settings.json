{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": ["Read(./dist/**)", "Read(./playwright-report/**)"]
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.cursor/hooks/bootstrap-shared-repo.mjs\"",
						"timeout": 180
					}
				]
			}
		]
	}
}
